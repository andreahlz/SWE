#swe project config (for bash scripts)

#genome_multifasta="data/genomes/multifasta/test_mock_gut_genomes.fna" # i think this one is wrong now
#abundance_file="data/abundances/test_abbundance.txt"

genome_multifasta="temp/genomes/test_combined_genomes.fna"
abundance_file="temp/test_abundance.txt"

out_dir_shortreads="temp/simulated_reads/short_reads"
out_dir_longreads="temp/simulated_reads/long_reads"

#output file names
multi_fasta_name="test_temp.fna"
short_reads_output="test_short_reads"
long_reads_output="test_long_reads"

# Genome download parameters
input_file="temp/test_abundance.txt"
genome_output_dir="temp/genomes/processed"
download_timeout=300

# Genome processing parameters
processed_genomes_dir="temp/genomes/processed"
newheader_dir="temp/genomes/processed/newheader"
headers_csv="temp/genomes/header_info.csv"
combined_multifasta="temp/genomes/test_combined_genomes.fna"

#insilco parameters
n_reads=20
error_model="MiSeq"
seed=42
cpus=1

#Badreads parameters
mean_length=10000
length_stdev=5000
mean_identity=95
identity_stdev=5
