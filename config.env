#swe project config (for bash scripts)

#genome_multifasta="data/genomes/multifasta/test_mock_gut_genomes.fna" # i think this one is wrong now
#abundance_file="data/abundances/test_abbundance.txt"

genome_multifasta="data/genomes/combined_genomes.fna"
abundance_file="data/input/input.txt"

out_dir_shortreads="data/simulated_reads/short_reads"
out_dir_longreads="data/simulated_reads/long_reads"

#output file names
multi_fasta_name="test_mock.fna"
short_reads_output="short_reads"
long_reads_output="long_reads"

# Genome download parameters
input_file="data/input/input.txt"
genome_output_dir="data/genomes/processed"
download_timeout=300

# Genome processing parameters
processed_genomes_dir="data/genomes/processed"
newheader_dir="data/genomes/processed/newheader"
headers_csv="data/genomes/header_info.csv"
combined_multifasta="data/genomes/combined_genomes.fna"

#insilco parameters
n_reads=20
error_model="MiSeq"
seed=42
cpus=1

#Badreads parameters
mean_length=10000
length_stdev=5000
mean_identity=95
identity_stdev=5
